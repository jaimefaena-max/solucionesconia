# Dependencias
node_modules/
# package-lock.json SÍ se versiona: es lo que garantiza que el build de Tailwind
# use la MISMA versión exacta en cada máquina (dev, VPS, CI). Ignorarlo dejaba el
# rango ^3.4.x libre y el CSS compilado podía variar entre despliegues.
yarn.lock
pnpm-lock.yaml

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Entornos y variables sensibles
.env
.env.local
.env.*.local

# Datos de clientes (PII: cédulas, documentos tributarios y legales).
# NUNCA se versionan — el repo se publica en GitHub. El contenido de cada
# cliente se aprovisiona fuera de banda en el entorno que lo sirve.
Clientes/

# Editores / IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / temporales
dist/
build/
.cache/
.tmp/

# Rotacion de API_SECRET_TOKEN (2026-08-12) — nunca commitear
.nuevo_api_secret.txt
.zasa_estado_auditoria.md
